{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Static Assets SPA. The @cloudflare/vite-plugin sets `assets.directory`
  // to the Vite client build output automatically, so only routing is configured here.
  // `single-page-application` serves index.html for unmatched navigation requests,
  // which is required for vue-router history mode (/dashboard, /cases/:id, ...).
  "name": "adjuster-portal",
  "compatibility_date": "2026-09-08",
  "assets": {
    "not_found_handling": "single-page-application",
  },
}
